# LLM — Fase 4 (Gemini primary, DeepSeek fallback, fake en CI)
PROCUREMENT_LLM_PROVIDER=auto  # auto | gemini | deepseek | fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
PROCUREMENT_LLM_FALLBACK_ENABLED=true
PROCUREMENT_PROMPT_VERSION=procurement-v1
PROCUREMENT_GRAPH_VERSION=procurement-graph-v1
# Budgets
PROCUREMENT_MAX_TOOL_CALLS=20
PROCUREMENT_MAX_SUPPLIER_QUERIES=5
PROCUREMENT_MAX_PROPOSALS=3
# DB
PROCUREMENT_DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5432/procurement
PROCUREMENT_REDIS_URL=redis://localhost:6379/0
